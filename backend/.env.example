# Copy this file to .env and set values as needed.
# Do not commit .env (it should be in .gitignore).

# =============================================================================
# DEVELOPMENT (recommended for daily work — saves Neon CU-hours)
# =============================================================================
# Leave DATABASE_URL unset so the API uses local Postgres.
# Start DB:  docker compose up -d postgres
# Start API: cd backend && npm start
#
PGHOST=localhost
PGPORT=5432
PGDATABASE=wood_more
PGUSER=wood_more
PGPASSWORD=wood_more

# =============================================================================
# PRODUCTION / intentional Neon only (Render + rare maintenance scripts)
# =============================================================================
# Keep this COMMENTED OUT on your laptop. Put the real URL on Render only.
# Running the API or scripts against Neon while coding keeps compute ACTIVE.
#
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# If Neon adds channel_binding=require, you may keep it locally; the API strips
# it at runtime for node-pg / Render compatibility.
#
# Scripts that write to Neon also require:
#   CONFIRM_PRODUCTION=1
#   or  --confirm-production

# API port (default 3000)
# PORT=3000

# Optional: run schema ensures on process boot (default is deferred until first real API request).
# Leave unset on Render Free to avoid Neon wakes from bots/health-only cold starts.
# RUN_STARTUP_MIGRATIONS_ON_BOOT=1
